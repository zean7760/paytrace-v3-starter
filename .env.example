# Copy to .env and fill in. Never commit .env or share it with clients.
PT_BASE_URL=https://api.sandbox.paytrace.com
PT_USERNAME=
PT_PASSWORD=
PT_INTEGRATOR_ID=
PT_MERCHANT_ID=
PORT=3000

# Field names for the Protect.js sale body. Protect.js returns hpf_token and enc_key.
# The V3 spec may name them pt_protect_token and encryption_key instead.
# If a Protect sale returns 422, swap these and retry. No code change needed.
PT_PROTECT_TOKEN_FIELD=hpf_token
PT_PROTECT_KEY_FIELD=enc_key

# Set after your first checkout with "Save card" ticked. Used by the example scripts.
CUSTOMER_ID=
