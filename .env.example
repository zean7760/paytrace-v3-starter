# Copy to .env and fill in. Never commit .env or share it with clients.
# Required, no default. Sandbox: https://api.sandbox.paytrace.com
# Production: https://api.paytrace.com
PT_BASE_URL=
PT_USERNAME=
PT_PASSWORD=
PT_INTEGRATOR_ID=
PT_MERCHANT_ID=
PORT=3000

# Set after your first checkout with "Save card" ticked. Used by the example scripts.
CUSTOMER_ID=
